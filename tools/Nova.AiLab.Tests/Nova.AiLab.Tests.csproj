<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Nova.AiLab.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);NOVA_FIXED_POINT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Project\Scripts\Simulation\**\*.cs" Link="Simulation\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Project\Scripts\AI\**\*.cs" Link="AI\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Project\Scripts\AI.Data\**\*.cs" Link="AI.Data\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The lab under test (Program.cs entry point excluded). -->
    <Compile Include="..\Nova.AiLab\MatchSpec.cs" Link="AiLab\MatchSpec.cs" />
    <Compile Include="..\Nova.AiLab\CanonicalOpening.cs" Link="AiLab\CanonicalOpening.cs" />
    <Compile Include="..\Nova.AiLab\MultiSlotAiHost.cs" Link="AiLab\MultiSlotAiHost.cs" />
    <Compile Include="..\Nova.AiLab\MatchRun.cs" Link="AiLab\MatchRun.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
