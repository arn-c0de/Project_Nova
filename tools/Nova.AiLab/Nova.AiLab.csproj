<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Nova.AiLab</RootNamespace>
    <!-- Same determinism define the Unity host, SimRunner and the test lane
         use (docs/tech/SimulationCore.md section 9). -->
    <DefineConstants>$(DefineConstants);NOVA_FIXED_POINT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Project\Scripts\Simulation\**\*.cs" Link="Simulation\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The gap this lab closes (plan section 1): Nova.SimRunner.csproj links
         Core/Simulation/Networking but NOT AI/, so the AI match only ran
         headless through the test project. The lab binds the AI sources
         itself; the SimRunner csproj is the pattern, not the template. -->
    <Compile Include="..\..\Assets\_Project\Scripts\AI\**\*.cs" Link="AI\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- AI.Data/ holds only an asmdef today; the glob matches nothing yet and
         is wired here so E6 (profiles as data) needs no csproj change. -->
    <Compile Include="..\..\Assets\_Project\Scripts\AI.Data\**\*.cs" Link="AI.Data\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
